# 复制为 backend/.env.local.properties（被 Git 忽略），只在本机填写。
# MIAOJI_DB_URL=jdbc:mysql://127.0.0.1:3306/专用数据库名?connectionTimeZone=UTC
# MIAOJI_DB_USERNAME=专用数据库账号
# MIAOJI_DB_PASSWORD=本机填写
# MIAOJI_PORT=8080
# MIAOJI_COOKIE_SECURE=false
# 正式 HTTPS 环境必须为 true；数据库必须专用于本项目且不能包含已有业务表。
# MIAOJI_EMAIL_ENABLED=false
# MIAOJI_SMTP_HOST=smtp.163.com
# MIAOJI_SMTP_PORT=465
# MIAOJI_SMTP_USERNAME=本机填写发信邮箱
# MIAOJI_SMTP_AUTHORIZATION=本机填写163客户端授权码（不是邮箱登录密码）
# 尚未填写/验证时保持EMAIL_ENABLED=false，不向真实收件人发信。
# MIAOJI_AI_ENABLED=false
# MIAOJI_GLM_API_KEY=本机填写智谱项目密钥（仅后端，不放VITE变量）
# 固定 glm-4-flash-250414；用户主动提交的文字与候选草稿会发往智谱。
