# 后端环境变量名示例（真实值不写入仓库）
# systemd 读取 /etc/miaoji/backend.env；同时会作为 .env.local.properties 放在后端工作目录。
MIAOJI_DB_URL=jdbc:mysql://127.0.0.1:3306/miaoji?connectionTimeZone=UTC
MIAOJI_DB_USERNAME=miaoji
MIAOJI_DB_PASSWORD=<在服务器上随机生成，仅存放于服务器>
MIAOJI_PORT=8081
MIAOJI_STORAGE_DIR=/opt/miaoji/storage
MIAOJI_EMAIL_ENABLED=true
MIAOJI_SMTP_USERNAME=<163邮箱账号>
MIAOJI_SMTP_AUTHORIZATION=<163邮箱授权码>
MIAOJI_AI_ENABLED=true
MIAOJI_GLM_API_KEY=<GLM密钥>
